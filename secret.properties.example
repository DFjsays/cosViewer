# 复制为 secret.properties 并填入真实值；secret.properties 已在 .gitignore 中
# 接口地址（AES 加密数据接口）
api.host=https://api.cos-dkop.net/api/app/v1
# 接口 AES-256-ECB 密钥源字符串（md5 后作为密钥）
api.key=CosAppMakeBigMoneyCosplayAPPContent
# 游客 token 前缀（请求头 Tokenparam 前半段）
api.tokenPrefix=CosAppMakeBigMoney
# 请求 UA
api.ua=cosav/3.0.24
# 云端配置下发地址（可留空）
api.cloud=https://di4n3-c01.tos-cn-hongkong.bytepluses.com/cossvr2025.txt
# GitHub 仓库 owner/repo，用于检查更新
update.owner=YOUR_GITHUB_NAME
update.repo=cosViewer
# 发布用 Personal Access Token（classic，勾 repo；不入库）
github.token=

# 签名文件与密码（本机路径，不入库）
build.keystore=/root/workspace/android-build/debug.keystore
build.keystorePass=android
